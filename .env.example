# EmailJS credentials — get them from https://dashboard.emailjs.com
# VITE_EMAILJS_SERVICE_ID  = Dashboard > Email Services > your service
# VITE_EMAILJS_TEMPLATE_ID = Dashboard > Email Templates > your template
# VITE_EMAILJS_PUBLIC_KEY  = Dashboard > Account > API Keys > Public Key
#
# These are read at build time and are NOT committed to git. If the site is
# deployed (Vercel, Netlify, etc.), add the same variables in the hosting
# dashboard's environment settings and redeploy — filling this file locally
# only affects local builds.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
