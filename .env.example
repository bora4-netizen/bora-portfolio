# EmailJS credentials — get them from https://dashboard.emailjs.com
# VITE_EMAILJS_SERVICE_ID  = Dashboard > Email Services > your service
# VITE_EMAILJS_TEMPLATE_ID = Dashboard > Email Templates > your template
# VITE_EMAILJS_PUBLIC_KEY  = Dashboard > Account > API Keys > Public Key

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
